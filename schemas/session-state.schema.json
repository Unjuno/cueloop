{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueloop.dev/schemas/session-state.schema.json",
  "title": "SessionState",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "goal",
    "started_at",
    "working_summary",
    "open_questions",
    "recent_interventions"
  ],
  "properties": {
    "session_id": {"type": "string", "minLength": 1},
    "goal": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": ["string", "null"], "format": "date-time"},
    "working_summary": {"type": "string"},
    "current_claim": {"type": ["string", "null"]},
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "status"],
        "properties": {
          "id": {"type": "string"},
          "text": {"type": "string"},
          "status": {
            "type": "string",
            "enum": ["OBSERVATION", "INFERENCE", "HYPOTHESIS", "UNVERIFIED_FACT", "GROUNDED_FACT"]
          },
          "source_refs": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      },
      "default": []
    },
    "recent_interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "action", "status", "timestamp"],
        "properties": {
          "candidate_id": {"type": "string"},
          "action": {"type": "string"},
          "status": {"type": "string", "enum": ["DELIVERED", "CANCELLED", "EXPIRED"]},
          "timestamp": {"type": "string", "format": "date-time"},
          "reason": {"type": ["string", "null"]}
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw_audio_retained": {"type": "boolean", "default": false},
        "transcript_retained": {"type": "boolean", "default": true},
        "retention_expires_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
