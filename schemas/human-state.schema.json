{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueloop.dev/schemas/human-state.schema.json",
  "title": "HumanState",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "confidence", "evidence", "observed_at", "expires_at"],
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "PRODUCTIVE",
        "RETRIEVAL_FAILURE",
        "STRATEGY_FAILURE",
        "FIXATION",
        "STRUCTURE_GAP",
        "OVERLOAD"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "description"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["TRANSCRIPT", "TIMING", "PROSODY", "INTERACTION_HISTORY", "USER_SIGNAL"]
          },
          "description": {"type": "string", "minLength": 1},
          "source_span": {"type": ["string", "null"]}
        }
      }
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "notes": {"type": ["string", "null"]}
  }
}
