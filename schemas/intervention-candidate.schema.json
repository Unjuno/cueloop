{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cueloop.dev/schemas/intervention-candidate.schema.json",
  "title": "InterventionCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "action",
    "text",
    "intended_effect",
    "state",
    "confidence",
    "created_at",
    "expires_at",
    "delivery_constraints"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "action": {
      "type": "string",
      "enum": [
        "SILENCE",
        "BACKCHANNEL",
        "QUESTION",
        "MIRROR",
        "PERTURB",
        "CONSTRAIN",
        "RETRIEVE",
        "VERIFY"
      ]
    },
    "text": {"type": ["string", "null"], "maxLength": 120},
    "intended_effect": {"type": "string", "minLength": 1},
    "state": {"$ref": "human-state.schema.json"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "delivery_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allow_while_speaking", "requires_pause", "cooldown_ms"],
      "properties": {
        "allow_while_speaking": {"type": "boolean"},
        "requires_pause": {"type": "boolean"},
        "minimum_pause_ms": {"type": ["integer", "null"], "minimum": 0},
        "cooldown_ms": {"type": "integer", "minimum": 0},
        "max_delivery_latency_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "source_refs": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
